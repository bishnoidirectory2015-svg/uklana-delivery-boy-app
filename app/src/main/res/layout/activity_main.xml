<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#F7F8FA">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="76dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="14dp" android:paddingEnd="14dp" android:background="#FFFFFF">
            <ImageButton android:id="@+id/menuButton" android:layout_width="44dp" android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Menu"
                android:src="@drawable/ic_menu" android:padding="10dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:paddingStart="8dp">
                <TextView android:id="@+id/deliveryName" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Delivery Boy" android:textSize="20sp" android:textStyle="bold" android:textColor="#161B22"/>
                <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Assigned: 0  •  Delivered: 0" android:textSize="13sp" android:textColor="#68707C" android:layout_marginTop="3dp"/>
            </LinearLayout>
            <ImageButton android:id="@+id/refreshButton" android:layout_width="44dp" android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Refresh"
                android:src="@drawable/ic_refresh" android:padding="10dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="12dp" android:baselineAligned="false">

            <LinearLayout android:layout_width="0dp" android:layout_height="118dp" android:layout_weight="1"
                android:orientation="vertical" android:padding="14dp" android:background="@drawable/stat_card">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Company Cash" android:textSize="13sp" android:textColor="#556070"/>
                <TextView android:id="@+id/runningTotal" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="₹0.00" android:textSize="24sp" android:textStyle="bold" android:textColor="#111827"
                    android:layout_marginTop="7dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="40dp"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
                    
                    <Button android:id="@+id/companyHistoryButton" android:layout_width="0dp" android:layout_height="38dp"
                        android:layout_weight="1" android:minHeight="0dp" android:minWidth="0dp"
                        android:paddingStart="2dp" android:paddingEnd="2dp" android:text="History"
                        android:textAllCaps="false" android:textSize="12sp" android:textColor="#FF5A00"
                        android:backgroundTint="#FFFFFF"/>
                </LinearLayout>
            </LinearLayout>

            <Space android:layout_width="10dp" android:layout_height="1dp"/>

            <LinearLayout android:layout_width="0dp" android:layout_height="118dp" android:layout_weight="1"
                android:orientation="vertical" android:padding="14dp" android:background="@drawable/stat_card">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Online Delivery Charge" android:textSize="13sp" android:textColor="#556070"/>
                <TextView android:id="@+id/onlineDeliveryDue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="₹0.00" android:textSize="24sp" android:textStyle="bold" android:textColor="#111827"
                    android:layout_marginTop="7dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="40dp"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
                    <Button android:id="@+id/onlineHistoryButton" android:layout_width="0dp" android:layout_height="38dp"
                        android:layout_weight="1" android:minHeight="0dp" android:minWidth="0dp"
                        android:paddingStart="2dp" android:paddingEnd="2dp" android:text="History"
                        android:textAllCaps="false" android:textSize="12sp" android:textColor="#FF5A00"
                        android:backgroundTint="#FFFFFF"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal"
            android:paddingStart="12dp" android:paddingEnd="12dp">
            <Button android:id="@+id/pendingTab" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="CURRENT ORDERS" android:textStyle="bold" android:textSize="13sp" android:textAllCaps="false" android:background="@drawable/tab_button"/>
            <Space android:layout_width="8dp" android:layout_height="1dp"/>
            <Button android:id="@+id/doneTab" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="DONE ORDERS" android:textStyle="bold" android:textSize="13sp" android:textAllCaps="false" android:background="@drawable/tab_button"/>
        </LinearLayout>

        <TextView android:id="@+id/emptyText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:text="No current orders" android:textColor="#7B8490" android:textSize="15sp" android:padding="28dp"/>
        <LinearLayout android:id="@+id/ordersContainer" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="10dp"/>

        <Space android:layout_width="1dp" android:layout_height="24dp"/>
    </LinearLayout>
</ScrollView>
