<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F4F6F8">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UKLANA FOOD DELIVERY" android:textColor="#FF6D00" android:textStyle="bold" android:textSize="13sp"/>
  <TextView android:id="@+id/deliveryName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="25sp" android:textColor="#202124" android:textStyle="bold" android:paddingTop="4dp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
   <TextView android:id="@+id/statusText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#666666" android:paddingTop="5dp" android:paddingBottom="8dp"/>
   <Button android:id="@+id/refreshButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Refresh" android:textAllCaps="false"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
   <Button android:id="@+id/pendingTab" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="PENDING ORDERS" android:textStyle="bold"/>
   <Button android:id="@+id/doneTab" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="DONE ORDERS" android:textStyle="bold"/>
  </LinearLayout>
  <TextView android:id="@+id/emptyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="No pending delivery orders" android:textColor="#777777" android:textSize="16sp" android:padding="28dp"/>
  <LinearLayout android:id="@+id/ordersContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="10dp"/>

  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PAYMENT SUMMARY" android:textColor="#FF6D00" android:textStyle="bold" android:paddingTop="12dp"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Company Cash Collection (delivery charge excluded)" android:textColor="#666666" android:paddingTop="8dp"/>
  <TextView android:id="@+id/runningTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="₹0.00" android:textSize="31sp" android:textColor="#202124" android:textStyle="bold"/>
  <Button android:id="@+id/resetTotalButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="SUBMITTED — RESET COMPANY CASH"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="My Total Delivery Charge Earning" android:textColor="#666666" android:paddingTop="14dp"/>
  <TextView android:id="@+id/deliveryEarningTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="₹0.00" android:textSize="27sp" android:textStyle="bold"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Online Payment Delivery Charge Due" android:textColor="#666666" android:paddingTop="14dp"/>
  <TextView android:id="@+id/onlineDeliveryDue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="₹0.00" android:textSize="27sp" android:textStyle="bold"/>
  <Button android:id="@+id/resetOnlineDeliveryButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="ONLINE DELIVERY CHARGE PAID / RESET"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Last 10 Company Cash Reset History" android:textStyle="bold" android:paddingTop="18dp"/>
  <LinearLayout android:id="@+id/receivedHistoryContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Last 10 Online Delivery Charge Payment History" android:textStyle="bold" android:paddingTop="18dp"/>
  <LinearLayout android:id="@+id/onlineDeliveryHistoryContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
  <Button android:id="@+id/logoutButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="LOGOUT" android:layout_marginTop="16dp" android:layout_marginBottom="24dp"/>
 </LinearLayout>
</ScrollView>
